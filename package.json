{
  "name": "vite-plugin-console-log-advanced",
  "version": "1.0.1",
  "description": "Zero-dependency Vite plugin for advanced dev logging. Pretty grouped console output, auto caller info, silent in production.",
  "type": "module",
  "sideEffects": [
    "dist/index.js"
  ],
  "exports": {
    ".": {
      "types": "./vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./logger": {
      "types": "./index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "files": [
    "dist",
    "index.d.ts",
    "vite.d.ts"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "npm run build && node test/plugin.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "vite": "^6.3.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirrr1987/console-log-advanced.git"
  },
  "types": "./vite.d.ts",
  "keywords": [
    "vite-plugin",
    "vite",
    "console log",
    "console",
    "debug",
    "debugger",
    "development",
    "javaScript",
    "js",
    "log",
    "logger",
    "logging",
    "vue",
    "react",
    "angular",
    "ts",
    "TypeScript",
    "console logging",
    "advanced logging"
  ],
  "author": {
    "email": "maghami.a1987@gmail.com",
    "name": "Amir Maghami",
    "url": "http://amirmaghami.ir/"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/amirrr1987/console-log-advanced/issues"
  },
  "homepage": "https://github.com/amirrr1987/console-log-advanced#readme"
}
